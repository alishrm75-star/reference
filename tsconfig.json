{
    "compilerOptions": {
      "target": "ES2022",
      "lib": ["dom", "dom.iterable", "esnext"],
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "jsx": "preserve",
      "strict": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["./src/*"]
      },
      "esModuleInterop": true,
      "skipLibCheck": true,
      "resolveJsonModule": true,
      "noEmit": true,
      "incremental": true,
      "isolatedModules": true,
      "allowJs": false,
      "plugins": [{ "name": "next" }]
    },
    "include": ["src", "scripts", ".next/types/**/*.ts"],
    "exclude": ["node_modules"]
  }
  